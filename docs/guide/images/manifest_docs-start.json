  {
    "file": "03-gui-tour-cache.zh.png",
    "lang": "zh",
    "tab": "cache",
    "example": "examples/C/matrixmul.c",
    "actions": [
      "select_processor RV32_SS",
      "load_example",
      "run"
    ],
    "caption": "运行后的 Cache 标签页（L1 Data Cache）：预设、缓存表、统计与命中率曲线；无编译器时改用 examples/ELF/RanPi-RV32",
    "script": [
      "processor RV32_SS",
      "load examples/ELF/RanPi-RV32",
      "tab cache",
      "combo presets 0",
      "run 120000",
      "grab window"
    ],
    "shot_note": "No RISC-V C compiler on this machine, so examples/ELF/RanPi-RV32 (precompiled C) is run instead of matrixmul.c. The ~120000-cycle run is longer than \"Max. cache plot cycles\" (default 10000), so the plot shows the most recent cycles with the note above it."
  },
  {
    "file": "03-gui-tour-cache.en.png",
    "lang": "en",
    "tab": "cache",
    "example": "examples/C/matrixmul.c",
    "actions": [
      "select_processor RV32_SS",
      "load_example",
      "run"
    ],
    "caption": "Cache tab (L1 Data Cache) with preset, cache table, statistics and hit-rate plot after running; if no C compiler use examples/ELF/RanPi-RV32",
    "script": [
      "processor RV32_SS",
      "load examples/ELF/RanPi-RV32",
      "tab cache",
